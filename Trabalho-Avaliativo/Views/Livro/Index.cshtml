@model IEnumerable<Livraria.Models.LivroModel>

@{
    ViewData["Title"] = "Lista de Livros";
}

<div class="container mt-4">
    <h2>Lista de Livros Cadastrados</h2>
    <hr />
    
    <p>
        <a asp-action="Cadastrar" class="btn btn-primary">Cadastrar Novo Livro</a>
    </p>

    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>ISBN</th>
                <th>Título</th>
                <th>Descrição</th>
                <th>Valor</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Isbn</td>
                    <td>@item.Nome</td>
                    <td>@item.Descricao</td>
                    <td>@item.Valor.ToString("C")</td>
                </tr>
            }
        </tbody>
    </table>
</div>