@model Livraria.Models.LivroModel

@{
    ViewData["Title"] = "Cadastrar Livro";
}

<div class="container mt-4">
    <h2>Cadastro de Novo Livro</h2>
    <hr />

    <form asp-action="Cadastrar" method="post">
        <div class="mb-3">
            <label asp-for="Isbn" class="form-label">ISBN</label>
            <input asp-for="Isbn" class="form-control" placeholder="Digite o ISBN do livro" />
            <span asp-validation-for="Isbn" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Nome" class="form-label">Título</label>
            <input asp-for="Nome" class="form-control" placeholder="Digite o nome do livro" />
            <span asp-validation-for="Nome" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Descricao" class="form-label">Descrição</label>
            <textarea asp-for="Descricao" class="form-control" placeholder="Sinopse ou detalhes"></textarea>
        </div>

        <div class="mb-3">
            <label asp-for="Valor" class="form-label">Valor (R$)</label>
            <input asp-for="Valor" type="number" step="0.01" class="form-control" placeholder="0.00" />
            <span asp-validation-for="Valor" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-success">Salvar Livro</button>
        <a asp-action="Index" class="btn btn-secondary">Voltar para a Lista</a>
    </form>
</div>